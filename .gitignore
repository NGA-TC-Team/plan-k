# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ai-generated handoff & planning docs (local only)
/ai-docs

# sqlite (local DB lives in repo root, never committed)
*.db
*.db-journal
*.db-wal
*.db-shm

# mock dev data (P4 — replaced by SQLite in P5)
.next-mock-data.json

# chat session uploads (local-only, lives next to local.db)
/local-uploads

# playwright
/playwright-report/
/test-results/
/playwright/.cache/
